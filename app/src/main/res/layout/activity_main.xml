<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent"><TextView android:id="@+id/title" android:text="Workout Tracker" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/exercise" android:hint="Exercise" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/sets" android:inputType="number" android:hint="Sets" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/reps" android:inputType="number" android:hint="Reps" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/weight" android:inputType="numberDecimal" android:hint="Weight (kg)" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/save" android:text="Save Workout" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/history" android:textSize="16sp" android:paddingTop="20dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>